{
  "name": "signer",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted server-side email signatures for Microsoft 365 and Google Workspace",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "npm run dev --prefix web",
    "build": "npm run build --prefix web && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --prefix web"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.3.3",
    "fastify-plugin": "^5.0.1",
    "html-to-text": "^9.0.5",
    "ipaddr.js": "^2.2.0",
    "jose": "^6.0.11",
    "mailparser": "^3.7.2",
    "nodemailer": "^6.10.1",
    "openid-client": "^6.5.0",
    "qrcode": "^1.5.4",
    "smtp-server": "^3.13.6",
    "undici": "^7.10.0",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.15.21",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/smtp-server": "^3.5.10",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
