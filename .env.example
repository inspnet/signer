# Signer — self-hosted email signatures
# Copy to .env and fill in values for your environment.

# Public URL of this instance (used for OIDC redirects and links)
PUBLIC_URL=https://signer.example.com

# Super admin: this Entra/Google login becomes the first Owner
SUPER_ADMIN_EMAIL=it-admin@example.com

# Required in production: at least one of Entra or Google
# Microsoft Entra ID (Azure AD) app registration
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Optional: application (not delegated) credentials for directory sync
ENTRA_DIRECTORY_CLIENT_ID=
ENTRA_DIRECTORY_CLIENT_SECRET=

# Google Workspace OAuth client (login) + optional service account (directory)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_ADMIN_EMAIL=

# Session signing key. REQUIRED unless DEMO_MODE=true — the server refuses to
# start without it. Generate with: openssl rand -base64 48
SESSION_SECRET=

# SQLite path (default ./data/signer.db). Use Postgres later via a volume.
DATABASE_PATH=./data/signer.db

# HTTP
HTTP_PORT=3000
# Comma-separated extra origins for local Vite (dev only)
CORS_ORIGINS=http://localhost:5173

# SMTP signature gateway
SMTP_PORT=25
SMTP_SUBMISSION_PORT=587
SMTP_ALT_PORT=2525
# Restrict who may relay into Signer (CIDRs), e.g. the Microsoft 365 / Google
# connector ranges. Empty = accept from anyone that can reach the port, so if
# you leave it empty you MUST restrict the ports at the firewall (NSG, VPC
# firewall, security group). Startup warns when this is unset.
SMTP_ALLOWED_CIDRS=
# Hostname advertised in SMTP banner and TLS
SMTP_HOSTNAME=signer.example.com
TLS_CERT_PATH=
TLS_KEY_PATH=

# Where to send mail AFTER the signature is applied (back to M365 or Google)
# Microsoft 365: <domain>-com.mail.protection.outlook.com  port 25
# Google Workspace: smtp-relay.gmail.com  port 587
UPSTREAM_HOST=
UPSTREAM_PORT=25
UPSTREAM_SECURE=false
# Optional SMTP AUTH if using Google SMTP relay with authentication
UPSTREAM_USER=
UPSTREAM_PASS=
# Domain advertised on the certificate when talking to Exchange receive connectors
UPSTREAM_TLS_SERVERNAME=
# Verify the upstream TLS certificate. Leave on: turning it off lets anyone on
# the network path read and alter mail in transit. Only set to false for a lab
# host using a self-signed certificate.
UPSTREAM_TLS_REJECT_UNAUTHORIZED=true

# Header used to prevent connector loops (configure the same name in Exchange/Google rules)
PROCESSED_HEADER=X-Signer-MessageProcessed

# fail-open (deliver unsigned) or fail-closed (defer 4xx) if processing throws
FAILURE_MODE=fail-open

# Directory sync interval minutes (0 disables the timer; manual sync still works)
DIRECTORY_SYNC_MINUTES=240

# Demo mode: seed sample users/signatures and allow a local super-admin login
# Disable in production. Never enable when this instance handles real mail.
DEMO_MODE=false
AUTH_ALLOW_DEV_LOGIN=false
