# Signer — self-hosted email signatures
# Copy to .env and fill in values for your environment.

# Public URL of this instance (used for OIDC redirects and links)
PUBLIC_URL=https://signer.example.com

# Super admin: this Entra/Google login becomes the first Owner
SUPER_ADMIN_EMAIL=it-admin@example.com

# The organisation's main email domain. Only used to start the domain list on
# first run; add the tenant's other domains in the portal (Settings → Domains).
# Defaults to SUPER_ADMIN_EMAIL's domain.
PRIMARY_DOMAIN=

# Required in production: at least one of Entra or Google
# Microsoft Entra ID app registration. One app does both jobs:
#   sign-in        Redirect URI (Web): <PUBLIC_URL>/api/auth/entra/callback
#                  Delegated permissions: openid, profile, email
#   directory sync Application permissions: User.Read.All, Group.Read.All,
#                  GroupMember.Read.All, with admin consent granted
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Google Workspace OAuth client (login) + optional service account (directory)
#   sign-in        Authorized redirect URI: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_ADMIN_EMAIL=

# Session signing key. REQUIRED unless DEMO_MODE=true — the server refuses to
# start without it. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Where the SQLite database, uploads and the IP range cache live. Keep this
# OUTSIDE the git checkout so updates never touch it. The install script uses
# /var/lib/signer; Docker sets /data itself.
DATA_DIR=./data
# Database file; defaults to $DATA_DIR/signer.db. Only set it to move the
# database away from the rest of the data.
# DATABASE_PATH=

# HTTP
HTTP_PORT=3000
# 127.0.0.1 when Nginx/Caddy on the same machine fronts the portal (the
# install script sets this).
# Docker needs 0.0.0.0 inside the container, which is the default.
HTTP_HOST=0.0.0.0
# Which peers may set X-Forwarded-For: the reverse proxy in front of Signer.
# loopback = Nginx/Caddy on the same machine. Docker Compose sets
# loopback,uniquelocal to cover Docker's bridge network. Never "true": a client
# could then set its own address and skip the sign-in rate limit.
TRUST_PROXY=loopback
# Comma-separated extra origins for local Vite (dev only)
CORS_ORIGINS=http://localhost:5173

# SMTP signature gateway
SMTP_PORT=25
SMTP_SUBMISSION_PORT=587
SMTP_ALT_PORT=2525
# Restrict who may relay into Signer. Accepts explicit CIDRs and the provider
# names "microsoft" and "google", which expand to the sender ranges those
# providers publish in DNS (spf.protection.outlook.com, _spf.google.com) and
# refresh on their own. Mix freely:
#   SMTP_ALLOWED_CIDRS=microsoft,google,203.0.113.10/32
# Empty = accept from anyone that can reach the port, so if you leave it empty
# you MUST restrict the ports at the firewall (ufw, Linode Cloud Firewall).
# Startup warns when this is unset.
# Note: these ranges cover the whole provider platform, not just your tenant.
SMTP_ALLOWED_CIDRS=
# How often to re-resolve provider ranges, in minutes (0 disables the refresh).
SMTP_RANGE_REFRESH_MINUTES=720
# The public IPv4 Signer sends mail from, shown in the connector instructions.
# Detected from the network interface (checked against SMTP_HOSTNAME's DNS);
# only set it if the server is behind NAT or has several public addresses.
PUBLIC_IPV4=
# Hostname advertised in the SMTP banner; must match the TLS certificate.
SMTP_HOSTNAME=signer.example.com
# Certificate for SMTP STARTTLS. Required for Microsoft 365, whose connectors
# only deliver over TLS. The install script keeps a copy of the Let's Encrypt
# certificate at /etc/signer/tls/{fullchain,privkey}.pem.
# If set, both files must exist and be readable or the server will not start.
TLS_CERT_PATH=
TLS_KEY_PATH=

# Where to send mail AFTER the signature is applied (back to M365 or Google)
# Microsoft 365: <domain>-com.mail.protection.outlook.com  port 25
# Google Workspace: smtp-relay.gmail.com  port 587
UPSTREAM_HOST=
UPSTREAM_PORT=25
UPSTREAM_SECURE=false
# auto: for Microsoft 365, return each sender domain's mail to that domain's own
# MX (a *.mail.protection.outlook.com host), falling back to UPSTREAM_HOST.
# fixed: always UPSTREAM_HOST. Google always uses UPSTREAM_HOST.
UPSTREAM_ROUTING=auto
# Optional SMTP AUTH if using Google SMTP relay with authentication
UPSTREAM_USER=
UPSTREAM_PASS=
# Name to verify on the upstream server's certificate, if it differs from
# UPSTREAM_HOST. Normally leave empty.
UPSTREAM_TLS_SERVERNAME=
# Verify the upstream TLS certificate. Leave on: turning it off lets anyone on
# the network path read and alter mail in transit. Only set to false for a lab
# host using a self-signed certificate.
UPSTREAM_TLS_REJECT_UNAUTHORIZED=true

# Header used to prevent connector loops (configure the same name in Exchange/Google rules)
PROCESSED_HEADER=X-Signer-MessageProcessed

# fail-open (deliver unsigned) or fail-closed (defer 4xx) if processing throws.
# Mail that cannot be handed back upstream is always deferred, never dropped.
FAILURE_MODE=fail-open

# Retention, in days; 0 keeps forever. PRIVACY.md states these defaults, so
# update it if you change them.
# Activity log: time, sender, recipients, outcome. Never message content.
MAIL_LOG_RETENTION_DAYS=30
# Admin audit trail: who changed which signature, rule or role.
AUDIT_LOG_RETENTION_DAYS=365

# Directory sync interval in minutes (0 disables the timer; manual sync still
# works). A sync also runs a minute after Signer starts.
DIRECTORY_SYNC_MINUTES=60

# Sign-in attempts allowed per client IP per window, on the routes that start or
# complete a login. /api/auth/me and /api/auth/providers are not limited.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MINUTES=5
# How long each provider's OIDC discovery document is reused, in minutes.
# 0 disables caching and makes every sign-in hit the provider.
OIDC_DISCOVERY_CACHE_MINUTES=60

# Demo mode: seed sample users/signatures and allow a local super-admin login
# Disable in production. Never enable when this instance handles real mail.
DEMO_MODE=false
AUTH_ALLOW_DEV_LOGIN=false
